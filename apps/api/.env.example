# Server port
PORT=4000

# Allowed origin for CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# Supabase — service role key, server-side only, never exposed to the client.
# Get these from your Supabase project settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Binance Agent OS credentials are NOT declared here yet — that happens in
# Session 2 when the MCP connection is actually built (BINANCE_TESTNET_*,
# BINANCE_MAINNET_* per ruleset Section 2/9.7).
